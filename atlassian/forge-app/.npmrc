registry=https://registry.npmjs.org/
always-auth=false

# Atlassian Forge packages (@forge/*, @atlassian/*) require authentication
# to Atlassian's private registry. In CI/deployment environments, provide
# NPM_TOKEN environment variable before running 'npm install':
#
#   export NPM_TOKEN="<your_atlassian_npm_token>"
#   npm install
#
# Token acquisition: https://id.atlassian.com/manage-profile/security/api-tokens
#
# Alternatively, if using Forge CLI locally:
#   npm install -g @forge/cli
#   forge login
#   npm install (in this directory)
#
# The Forge CLI authenticates via browser OAuth and configures npm auth locally.

@forge:registry=https://registry.npmjs.org/
@atlassian:registry=https://registry.npmjs.org/
