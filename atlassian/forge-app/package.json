{
  "name": "@firstry/forge-app",
  "version": "2.14.0",
  "description": "FirstTry Governance - Atlassian Dual-Layer Integration",
  "main": "src/index.ts",
  "scripts": {
    "type-check": "tsc --noEmit",
    "build:gadget": "node tools/build_meta.mjs && cd src/gadget-ui && npm install && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:operator:full": "vitest run tests/operator_verification/ov_runner.test.ts && npx ts-node tests/operator_verification/ov_report_gen.ts",
    "test:credibility": "vitest run tests/credibility/gap1_pii_logging.test.ts tests/credibility/gap2_tenant_isolation_adversarial.test.ts tests/credibility/gap3_egress_static_and_runtime.test.ts tests/credibility/gap4_concurrency_idempotency.test.ts tests/credibility/gap5_determinism_10_runs.test.ts tests/credibility/gap6_storage_growth_quota_behavior.test.ts tests/credibility/gap7_support_incident_reality.test.ts",
    "verify:phase4": "node scripts/verify_phase4.mjs",
    "verify:phase5": "node scripts/verify_phase5.mjs",
    "verify:phase4-5": "node scripts/verify_phase4_5.mjs",
    "verify:ui-naming": "bash tools/verify_ui_naming_contract.sh",
    "verify:contracts": "npm run verify:ui-naming",
    "verify:layer0": "bash tools/verify_layer0_contract.sh",
    "lint": "echo \"lint: not configured (intentional)\"",
    "build": "node tools/build_meta.mjs && npm run build:gadget && node tools/run_build_with_meta.mjs && echo \"Backend build: not configured (intentional)\"",
    "predeploy:prod": "node tools/build_meta.mjs && npm run test && npm run build:gadget && echo \"UI build ready for deploy\"",
    "reviewer:gate": "bash audit/reviewer_ready_gate.sh",
    "proof:auth": "bash audit/proof_run_authenticated.sh",
    "audit:buildinfo": "bash ../../tools/audit_buildinfo_reachability.sh",
    "proof:buildinfo:prod": "bash ../../tools/prod_buildinfo_proof_loop.sh",
    "csp:lint": "node tools/csp_forbid_check.js",
    "csp:gate": "bash tools/csp_static_gate.sh"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^18.2.21",
    "@vitest/ui": "^4.0.16",
    "glob": "^13.0.0",
    "typescript": "^5.0.0",
    "uuid": "^13.0.0",
    "vitest": "^4.0.16",
    "yaml": "^2.8.2"
  },
  "_comment": "Forge CLI packages (@forge/api, @forge/ui) require authentication to private Atlassian registry. Installed via 'forge create' workflow in production. See docs/ATLASSIAN_DUAL_LAYER_SPEC.md for installation instructions.",
  "dependencies": {
    "@forge/api": "^6.4.2",
    "@forge/resolver": "^1.7.1",
    "pdfkit": "^0.17.2"
  }
}
