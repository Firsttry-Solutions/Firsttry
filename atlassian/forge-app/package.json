{
  "name": "@firstry/forge-app",
  "version": "2.14.0",
  "description": "FirstTry Governance - Atlassian Dual-Layer Integration",
  "main": "src/index.ts",
  "scripts": {
    "pretest": "node tools/build_meta.mjs",
    "type-check": "tsc --noEmit",
    "verify:bridge-installed": "node tools/verify_forge_bridge_installed.js",
    "verify:ui:no-fatal-dist": "bash tools/verify_no_fatal_ui_bridge_in_dist.sh",
    "verify:ui:no-top-level-throw": "bash tools/verify_no_top_level_throw_in_entry.sh",
    "verify:ui:no-legacy-states": "bash tools/verify_no_legacy_ui_states.sh",
    "verify:dist:no-legacy-flow": "bash tools/verify_dist_no_legacy_flow.sh",
    "verify:dist:identity-labels": "bash tools/verify_dist_identity_labels.sh",
    "verify:dist:invoke-allowlist": "bash tools/verify_dist_invoke_allowlist.sh",
    "verify:required-files": "bash tools/verify_required_files_present.sh",
    "verify:source:anchor-unique": "bash tools/verify_source_identity_anchor_unique.sh",
    "verify:bundle:integrity": "bash tools/verify_bundle_integrity.sh --bundle-file src/gadget-ui/dist/app.*.js",
    "verify:bundle:provenance": "bash tools/verify_bundle_provenance.sh",
    "verify:dist:anchor-unique": "bash tools/verify_identity_anchor_unique.sh",
    "verify:gates:selftest": "bash tools/test_gates_selftest.sh",
    "verify:no-wall-clock-in-meta": "bash tools/verify_no_wall_clock_in_meta_pipeline.sh",
    "verify:ui:no-runtime-meta": "bash tools/verify_no_runtime_build_meta_import.sh",
    "verify:no-tracked-changes": "bash tools/verify_no_tracked_changes_after_build.sh",
    "verify:dash-envelope-contract": "node tools/verify_dash_envelope_contract_consistency.mjs",
    "build:gadget": "npm run verify:bridge-installed && npm run verify:required-files && npm run verify:ui:no-runtime-meta && npm run verify:no-wall-clock-in-meta && npm run verify:dash-envelope-contract && node tools/build_meta.mjs && node tools/gen_ui_build_meta.mjs && cd src/gadget-ui && npm ci && npm run build && cd ../.. && npm run verify:ui:no-fatal-dist && npm run verify:ui:no-top-level-throw && npm run verify:ui:no-legacy-states && npm run verify:dist:invoke-allowlist && npm run verify:dist:identity-labels && npm run verify:source:anchor-unique && npm run verify:bundle:integrity && npm run verify:bundle:provenance && npm run verify:dist:anchor-unique && npm run verify:gates:selftest && npm run verify:lockfile:clean && npm run verify:no-tracked-changes",
    "test": "npm run verify:ui:no-runtime-meta && vitest run",
    "posttest": "bash tools/verify_no_tracked_changes_after_test.sh",
    "test:watch": "vitest",
    "test:operator:full": "vitest run tests/operator_verification/ov_runner.test.ts && npx ts-node tests/operator_verification/ov_report_gen.ts",
    "test:credibility": "vitest run tests/credibility/gap1_pii_logging.test.ts tests/credibility/gap2_tenant_isolation_adversarial.test.ts tests/credibility/gap3_egress_static_and_runtime.test.ts tests/credibility/gap4_concurrency_idempotency.test.ts tests/credibility/gap5_determinism_10_runs.test.ts tests/credibility/gap6_storage_growth_quota_behavior.test.ts tests/credibility/gap7_support_incident_reality.test.ts",
    "verify:phase4": "node scripts/verify_phase4.mjs",
    "verify:phase5": "node scripts/verify_phase5.mjs",
    "verify:phase4-5": "node scripts/verify_phase4_5.mjs",
    "verify:phase5:payload-commit-selftest": "bash tools/selftest_phase5_payload_commit.sh",
    "verify:phase5:freeze-lock-selftest": "bash tools/selftest_phase5_freeze_lock_run_scoped.sh",
    "release:freeze-lock": "node scripts/release_freeze_lock.mjs",
    "verify:ui-naming": "bash tools/verify_ui_naming_contract.sh",
    "verify:contracts": "npm run verify:ui-naming && npm run verify:error-envelope",
    "verify:error-envelope": "bash tools/verify_error_envelope_contract.sh",
    "verify:layer0": "bash tools/verify_layer0_contract.sh",
    "verify:no-window-invoke": "bash tools/verify_no_window_invoke.sh",
    "lint": "echo \"lint: not configured (intentional)\"",
    "build": "node tools/build_meta.mjs && npm run build:gadget && node tools/run_build_with_meta.mjs && echo \"Backend build: not configured (intentional)\"",
    "predeploy:prod": "node tools/build_meta.mjs && npm run test && npm run build:gadget && echo \"UI build ready for deploy\"",
    "reviewer:gate": "bash audit/reviewer_ready_gate.sh",
    "proof:auth": "bash audit/proof_run_authenticated.sh",
    "audit:buildinfo": "bash ../../tools/audit_buildinfo_reachability.sh",
    "proof:buildinfo:prod": "bash ../../tools/prod_buildinfo_proof_loop.sh",
    "csp:lint": "node tools/csp_forbid_check.js",
    "csp:gate": "bash tools/csp_static_gate.sh",
    "verify:backbone:l0": "bash tools/proof_backbone_l0.sh",
    "verify:lockfile:clean": "git diff --exit-code package-lock.json || (echo 'ERROR: package-lock.json has uncommitted changes (lockfile drift detected)' && exit 1)",
    "diag:dashboard": "node e2e/scripts/phase5_dashboard_diagnose.mjs",
    "prod:deploy-and-upgrade": "bash tools/prod_deploy_and_upgrade.sh",
    "test:prod-dashboard": "cd ../../e2e && xvfb-run --auto-servernum --server-args='-screen 0 1280x800x24' npx playwright test tests/prod_dashboard_green.spec.ts",
    "prod:ship-and-verify": "npm run prod:deploy-and-upgrade && npm run test:prod-dashboard",
    "jira:auth:capture": "node e2e/scripts/ft_capture_jira_storage_state.mjs",
    "jira:auth:verify": "VERIFY_ONLY=1 node e2e/scripts/ft_capture_jira_storage_state.mjs",
    "dashboard:auth": "npm run jira:auth:capture",
    "dashboard:smoke": "node e2e/scripts/ft_dashboard_smoke_proof.mjs",
    "dashboard:auth:refresh": "node e2e/scripts/auth_refresh_storage_state.mjs",
    "dashboard:state:verify": "node e2e/scripts/verify_storage_state.mjs",
    "prod:verify-deploy-upgrade": "bash tools/ft_verify_deploy_upgrade_prod.sh"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.30",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^18.2.21",
    "@vitest/ui": "^4.0.16",
    "glob": "^13.0.0",
    "typescript": "^5.0.0",
    "uuid": "^13.0.0",
    "vitest": "^4.0.16",
    "yaml": "^2.8.2"
  },
  "_comment": "Forge CLI packages available on npmjs. See docs/ATLASSIAN_DUAL_LAYER_SPEC.md for setup instructions.",
  "dependencies": {
    "@forge/api": "^7.0.0",
    "@forge/bridge": "^5.11.0",
    "@forge/resolver": "^1.7.1",
    "pdfkit": "^0.17.2"
  }
}
