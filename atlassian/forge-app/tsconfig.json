{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "jsx": "react",
    "jsxFactory": "view",
    "jsxFragmentFactory": "Fragment",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*", "src/gadget-ui/dist/**/*.js"],
  "exclude": ["node_modules", "**/*.test.ts", "src/gadget-ui/src/**/*"]
}
